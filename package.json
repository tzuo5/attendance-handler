{
  "name": "attendance-handler",
  "version": "0.1.0",
  "private": true,
  "description": "Visible-window iClicker classroom companion for macOS and Windows",
  "author": "Attendance Handler",
  "homepage": "https://github.com/tzuo5/attendance-handler#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tzuo5/attendance-handler.git"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:chrome-lifecycle": "node scripts/chrome-lifecycle.mjs",
    "test:integration": "node scripts/integration.mjs",
    "package": "npm run build && electron-builder --mac dir --arm64 --publish never",
    "dist:mac": "ATTENDANCE_UNIVERSAL=1 npm run build && electron-builder --mac dmg zip --universal --config.directories.output=release-public --publish never",
    "audit:public": "node scripts/audit-public.mjs",
    "demo": "node scripts/demo.mjs",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win dir --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --config.directories.output=release-public --publish never",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "com.attendancehandler.desktop",
    "productName": "Attendance Handler",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "dist-electron/tray.png",
      "dist-electron/attendance-native",
      "package.json",
      "!**/*.map",
      "dist-electron/icon.png",
      "dist-electron/attendance-native.exe"
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**/*",
      "dist-electron/attendance-native",
      "dist-electron/attendance-native.exe"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0.0",
      "x64ArchFiles": "**/attendance-native",
      "artifactName": "Attendance-Handler-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Attendance Handler",
      "contents": [
        {
          "x": 140,
          "y": 170,
          "type": "file"
        },
        {
          "x": 420,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "docs/assets/attendance-handler-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Attendance-Handler-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Attendance Handler",
      "runAfterFinish": false,
      "artifactName": "Attendance-Handler-${version}-win-${arch}-Setup.${ext}"
    }
  }
}
